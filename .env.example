# TMDb (The Movie Database) API Credentials
# Get your API key and bearer token from https://www.themoviedb.org/settings/api

# TMDb v3 API Key (Required for serverless proxy endpoints in /api)
TMDB_API_KEY=your_tmdb_api_key_here

# TMDb v4 Read Access Token / Bearer Token (Required for /api/details)
TMDB_AUTH_TOKEN=your_tmdb_bearer_token_here

# Optional: React App TMDB Image Base URL (Defaults to https://image.tmdb.org/t/p/original)
REACT_APP_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/original
