rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for application security
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile and Private Watch History Collections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Watch History subcollection
      match /watchHistory/{movieId} {
        allow read, write, delete: if isOwner(userId);
      }

      // User Preferences subcollection
      match /preferences/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Default deny all other paths for strict zero-trust security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
